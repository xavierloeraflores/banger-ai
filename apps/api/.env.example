DATABASE_URL=postgresql://localhost/banger
# The JWT must have sub and exp claims, with an RS256 or ES256 signature.
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=banger-api
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Use a private Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional public tunnel origin for signed upload callbacks in local development.
VERCEL_BLOB_CALLBACK_URL=
# Sandbox uses the deployment OIDC identity. For local runs, pull Vercel env values.
VERCEL_OIDC_TOKEN=
BANGER_PROVIDER=openai
BANGER_MODEL=
BANGER_API_KEY=
# Set from the publish-runner script output after building the trusted bundle.
SANDBOX_RUNNER_BLOB_PATH=
CRON_SECRET=

# ElevenLabs Music upload, composition plans, and inpainting.
ELEVENLABS_API_KEY=

# Browser access at the same origin as the UI. Keep these values server-only.
APP_ORIGIN=http://localhost:3000
# Browser accounts use PostgreSQL. Apply migrations before serving requests.
