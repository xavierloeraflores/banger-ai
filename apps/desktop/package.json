{
  "name": "@banger/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm compile && node scripts/dev.mjs",
    "build": "pnpm compile && node scripts/copy-assets.mjs",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "compile": "tsc -p tsconfig.json && node scripts/copy-preload.mjs",
    "test": "pnpm compile && node --test tests/*.test.mjs",
    "smoke": "electron scripts/smoke.mjs",
    "smoke:byok": "electron scripts/smoke-byok.mjs",
    "smoke:chat": "electron scripts/smoke-chat.mjs",
    "smoke:web": "electron scripts/smoke-web.mjs",
    "smoke:chatgpt": "electron scripts/smoke-chatgpt.mjs",
    "smoke:musical": "electron scripts/smoke-musical-options.mjs",
    "smoke:workspace": "electron scripts/smoke-workspace.mjs",
    "smoke:local": "electron scripts/smoke-local.mjs",
    "smoke:sequencer": "electron scripts/smoke-sequencer.mjs",
    "smoke:grid": "electron scripts/smoke-shared-grid.mjs",
    "smoke:song": "electron scripts/smoke-song.mjs",
    "smoke:song:web": "electron scripts/smoke-song.mjs --web",
    "smoke:cloud": "electron scripts/smoke-cloud.mjs",
    "smoke:music": "electron scripts/smoke-music.mjs",
    "smoke:music:web": "electron scripts/smoke-music.mjs --web"
  },
  "devDependencies": {
    "@banger/eslint-config": "workspace:*",
    "@banger/typescript-config": "workspace:*",
    "@types/node": "^22.19.0",
    "electron": "^45.2.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@banger/agent": "workspace:*",
    "@banger/elevenlabs": "workspace:*",
    "@banger/harness": "workspace:*",
    "jose": "^6.2.14"
  }
}
