tempo 112;
meter 4/4;

track kick {
  sound "drums/kick";
  rhythm "x . . . x . . . x . . . x . . .";
  gain .75;
  output drums;
}

track snare {
  sound "drums/snare";
  rhythm ". . . . x . . . . . . . x . . .";
  gain .45;
  pan .1;
  output drums;
  send space .08;
}

track hats {
  sound "drums/hat";
  rhythm "x . x x x . x . x . x x x . x .";
  gain .22;
  pan -.25;
  groove { quantize .25; swing .2; humanize .008; seed 17; }
  output drums;
}

track bass {
  instrument "synth/bass";
  bars 2;
  notes "C2 . C2 G1 . C2 . . Ab1 . Ab1 Eb2 . G1 . .";
  gain .48;
  effect filter { cutoff 1400; resonance 1; }
  effect distortion { amount .18; mix .12; }
  effect compressor { threshold -28; ratio 6; attack .005; release .16; knee 12; sidechain kick; }
  automation "filter.cutoff" { point 0 500; point 4 1800; point 8 500; }
  output music;
}

track keys {
  instrument "synth/keys";
  bars 2;
  piano {
    note "C4" start 0 duration 3.5 velocity .65;
    note "Eb4" start 0 duration 3.5 velocity .55;
    note "G4" start 0 duration 3.5 velocity .6;
    note "Ab3" start 4 duration 3.5 velocity .6;
    note "C4" start 4 duration 3.5 velocity .55;
    note "Eb4" start 4 duration 3.5 velocity .65;
  }
  pattern chorus {
    bars 4;
    piano {
      note "C4" start 0 duration 7.5 velocity .7;
      note "Eb4" start 0 duration 7.5 velocity .6;
      note "G4" start 0 duration 7.5 velocity .65;
      note "Ab3" start 8 duration 3.5 velocity .7;
      note "C4" start 8 duration 3.5 velocity .6;
      note "Eb4" start 8 duration 3.5 velocity .65;
      note "G3" start 12 duration 3.5 velocity .7;
      note "B3" start 12 duration 3.5 velocity .6;
      note "D4" start 12 duration 3.5 velocity .65;
    }
  }
  gain .32;
  pan -.15;
  effect eq { low -4; mid 1; high 2; }
  effect delay { time .268; feedback .3; mix .12; }
  automation "delay.mix" { point 0 .08; point 8 .25; point 16 .08; }
  send space .15;
  output music;
}

track pad {
  instrument "synth/pad";
  bars 4;
  piano {
    note "C3" start 0 duration 8 velocity .5;
    note "G3" start 0 duration 8 velocity .4;
    note "Ab2" start 8 duration 8 velocity .5;
    note "Eb3" start 8 duration 8 velocity .4;
  }
  gain .22;
  effect filter { cutoff 1200; resonance .5; }
  automation "gain" { point 0 .05; point 4 .25; point 12 .25; point 16 .05; }
  send space .3;
  output music;
}

track lead {
  instrument "synth/lead";
  bars 2;
  notes "C5 . Eb5 G5 . Eb5 . D5 C5 . . G4 Bb4 . G4 .";
  gain .2;
  pan .2;
  effect delay { time .402; feedback .35; mix .2; }
  automation "pitch" { point 0 0; point 6 0; point 7 .25; point 8 0; }
  send space .1;
  output music;
}

track bell {
  instrument "synth/bell";
  bars 2;
  notes "C6 . . . . G5 . .";
  gain .18;
  pan .4;
  send space .35;
  output music;
}

bus drums {
  gain .85;
  effect eq { low 1; mid -2; high 1; }
  effect compressor { threshold -18; ratio 3; attack .02; release .15; knee 12; }
}
bus music { gain .8; }
bus space { gain .45; effect reverb { mix 1; } }

section intro { bars 4; play keys; play pad; play bell; }
section verse { bars 8; play kick; play snare; play hats; play bass; play keys; }
section chorus { bars 8; play kick; play snare; play hats; play bass; play keys chorus; play pad; play lead; play bell; }
section outro { bars 4; play keys; play pad; play bell; }
song { play intro; play verse; play chorus; play verse; play chorus; play outro; }
