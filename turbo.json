{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["examples/night-drive.banger"],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**"
      ]
    },
    "dev": {
      "passThroughEnv": ["PORT", "BANGER_DEV_URL"],
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "@banger/desktop#build": {
      "dependsOn": [
        "@banger/www#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@banger/desktop#dev": {
      "passThroughEnv": ["PORT", "BANGER_DEV_URL"],
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    }
  }
}
