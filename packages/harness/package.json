{
  "name": "@banger/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "banger-agent": "./bin/banger-agent.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@banger/agent": "workspace:*",
    "@banger/compiler": "workspace:*",
    "ai": "^7.0.159",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@banger/eslint-config": "workspace:*",
    "@banger/typescript-config": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3"
  }
}
