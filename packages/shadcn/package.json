{
  "name": "@banger/shadcn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "./globals.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/theme.css -o dist/styles.css --minify",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@banger/eslint-config": "workspace:*",
    "@banger/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "components.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.2",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.67.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.17.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  }
}
