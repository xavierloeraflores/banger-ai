{
  "name": "@banger/shadcn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('src/styles.css', 'dist/styles.css');\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@banger/eslint-config": "workspace:*",
    "@banger/typescript-config": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  }
}
