{
  "name": "banger-ai",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:www": "node scripts/dev.mjs --filter=@banger/api",
    "dev:desktop": "node scripts/dev.mjs --filter=@banger/desktop --filter=@banger/www",
    "build": "turbo run build",
    "fullbuild": "cross-env NODE_ENV=production turbo run build",
    "desktop:pack": "pnpm --filter @banger/desktop package --dir",
    "desktop:dist": "pnpm --filter @banger/desktop package",
    "desktop:dist:mac": "pnpm --filter @banger/desktop package --mac",
    "desktop:dist:win": "pnpm --filter @banger/desktop package --win",
    "desktop:dist:linux": "pnpm --filter @banger/desktop package --linux",
    "desktop:smoke": "pnpm --filter @banger/desktop smoke:packaged",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify:audio": "pnpm --filter @banger/desktop exec electron ../../packages/engine/test/render.cjs",
    "verify:song": "pnpm --filter @banger/desktop exec electron ../../scripts/verify-song.mjs",
    "start:web": "pnpm --filter @banger/api start",
    "test": "node scripts/test-suites.mjs",
    "test:affected": "node scripts/test-suites.mjs",
    "test:plan": "node scripts/test-suites.mjs --list",
    "test:all": "node scripts/test-suites.mjs --all",
    "test:suite": "node scripts/test-suites.mjs --suite"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "cross-env": "^10.1.0"
  }
}
